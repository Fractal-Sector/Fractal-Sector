<BoxContainer xmlns="https://spacestation14.io"
              xmlns:viewport="clr-namespace:Content.Client.Viewport"
              Orientation="Vertical"
              MinSize="480 340" HorizontalExpand="True" VerticalExpand="True" Margin="4">

        <!-- List of streams + start-your-own panel -->
        <BoxContainer Name="ListScreen" Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True">
            <BoxContainer Name="StartStreamRow" Orientation="Horizontal">
                <LineEdit Name="StreamTitleInput" HorizontalExpand="True" PlaceHolder="{Loc 'live-stream-title-placeholder'}" />
                <Button Name="StartStreamBtn" Text="{Loc 'live-stream-start-button'}" />
            </BoxContainer>
            <Label Name="StreamCountLabel" Margin="0 4 0 4" />
            <ScrollContainer VerticalExpand="True" HorizontalExpand="True">
                <BoxContainer Name="StreamListContainer" Orientation="Vertical" />
            </ScrollContainer>
        </BoxContainer>

        <!-- You are streaming -->
        <BoxContainer Name="StreamerScreen" Orientation="Horizontal" HorizontalExpand="True" VerticalExpand="True" Visible="False">
            <BoxContainer Orientation="Vertical" HorizontalExpand="True">
                <BoxContainer Orientation="Horizontal">
                    <Label Name="StreamerLiveLabel" />
                    <Control HorizontalExpand="True" />
                    <Label Name="StreamerViewerLabel" />
                </BoxContainer>
                <BoxContainer Name="StreamerChatContainer" Orientation="Vertical" MinHeight="80" VerticalExpand="True" />
                <BoxContainer Orientation="Horizontal">
                    <LineEdit Name="StreamerChatInput" HorizontalExpand="True" />
                    <Button Name="StreamerChatSendBtn" Text="{Loc 'live-stream-send-button'}" />
                </BoxContainer>
                <Button Name="StopStreamBtn" Text="{Loc 'live-stream-stop-button'}" />
            </BoxContainer>
            <BoxContainer Orientation="Vertical" MinWidth="140" Margin="6 0 0 0">
                <Label Text="{Loc 'live-stream-top-donators-label'}" />
                <BoxContainer Name="StreamerDonatorsList" Orientation="Vertical" Margin="0 2 0 0" />
            </BoxContainer>
        </BoxContainer>

        <!-- Watching someone else's stream -->
        <BoxContainer Name="ViewerScreen" Orientation="Horizontal" HorizontalExpand="True" VerticalExpand="True" Visible="False">
            <BoxContainer Orientation="Vertical" HorizontalExpand="True">
                <BoxContainer Orientation="Horizontal">
                    <Label Name="ViewerStreamerLabel" />
                    <Control HorizontalExpand="True" />
                    <Label Name="ViewerLiveLabel" />
                </BoxContainer>
                <Control MinHeight="190" HorizontalExpand="True" Margin="0 2 0 2">
                    <viewport:ScalingViewport Name="CameraView"
                                              HorizontalExpand="True"
                                              VerticalExpand="True"
                                              MinSize="260 190"
                                              MouseFilter="Ignore" />
                </Control>
                <BoxContainer Name="ViewerChatContainer" Orientation="Vertical" MinHeight="50" VerticalExpand="True" />
                <BoxContainer Orientation="Horizontal">
                    <LineEdit Name="ViewerChatInput" HorizontalExpand="True" />
                    <Button Name="ViewerSendBtn" Text="{Loc 'live-stream-send-button'}" />
                </BoxContainer>
                <Button Name="BackToListBtn" Text="{Loc 'live-stream-back-button'}" />
            </BoxContainer>
            <BoxContainer Orientation="Vertical" MinWidth="140" Margin="6 0 0 0">
                <Label Text="{Loc 'live-stream-top-donators-label'}" />
                <BoxContainer Name="ViewerDonatorsList" Orientation="Vertical" Margin="0 2 0 0" />
                <Control VerticalExpand="True" />
                <Button Name="ViewerDonateBtn" Text="{Loc 'live-stream-donate-button'}" ToggleMode="True" />
                <BoxContainer Name="DonatePanel" Orientation="Vertical" Visible="False">
                    <LineEdit Name="DonateAmountInput" PlaceHolder="{Loc 'live-stream-donate-amount-placeholder'}" />
                    <LineEdit Name="DonateMessageInput" PlaceHolder="{Loc 'live-stream-donate-message-placeholder'}" />
                    <Button Name="DonateSubmitBtn" Text="{Loc 'live-stream-donate-submit-button'}" />
                </BoxContainer>
            </BoxContainer>
        </BoxContainer>

</BoxContainer>
